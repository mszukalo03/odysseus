{
  "manifest_version": 3,
  "name": "Odysseus — Argos",
  "version": "1.0.0",
  "description": "Ask your self-hosted Odysseus about the page you're on.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Ask Odysseus about this page"
  }
}
